# SQLite database path (created if missing)
PAPR_DB=./papr.db

# HTTP listen port
# Local Vite `pnpm dev` proxies /api here (often 8080; override with PAPR_API_PROXY).
# Production package / scripts default to 7400.
PORT=8080

# Admin seed (created on first boot; password required in production)
PAPR_ADMIN_USER=admin
PAPR_ADMIN_PASSWORD=changeme
# Set to 1 to reset the admin password on startup
# PAPR_ADMIN_RESET=0

# Optional: seed a directory-index feed source URL
# PAPR_FEED_SOURCE_URL=https://example.com/feeds/

# Optional: directory of Vite `pnpm build` output to serve
# PAPR_STATIC_DIR=./dist
