# Copy to scripts/deploy.env (gitignored) and fill in.
# Never commit deploy.env, passwords, or private keys.

# SSH target (user@host, or an OpenSSH Host alias from ~/.ssh/config)
PAPR_DEPLOY_HOST=root@YOUR_SERVER_IP

# Remote install directory
PAPR_DEPLOY_PATH=/product/papr

# HTTP port (also seeded into package .env.example)
PORT=7400

# Optional SSH extras:
# PAPR_SSH_PORT=22
# PAPR_SSH_CONFIG=/path/to/ssh_config   # OpenSSH config only (not expect scripts)
#
# Prefer key-based auth:
#   ssh-copy-id -p 22 root@YOUR_SERVER_IP
#
# Password auth (optional; requires sshpass — brew install sshpass):
# PAPR_SSH_PASSWORD='…'

# GitHub repo for --from-release (optional; auto-detected via gh / git remote)
# PAPR_GH_REPO=l0ng-ai/papr

# Set 1 only when you intentionally want to overwrite remote .env
# PAPR_SYNC_ENV=0

# Production updates (no local compile):
#   scripts/deploy.sh --from-release latest
#   scripts/deploy.sh --from-release v0.15.0
